{
    "name": "stock-analyze-web",
    "compatibility_date": "2024-04-01",
    "assets": {
        "directory": "./dist"
    },
    "routes": [
        {
            "pattern": "stock-analyze.ohchans.com/*",
            "zone_name": "ohchans.com"
        }
    ],
    "observability": {
        "enabled": true
    }
}