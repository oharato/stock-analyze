# Cloudflare R2 Credentials
# These should be set as secrets on Cloudflare:
# pnpm wrangler secret put R2_ACCESS_KEY_ID
# pnpm wrangler secret put R2_SECRET_ACCESS_KEY
# pnpm wrangler secret put CLOUDFLARE_ACCOUNT_ID

# Bucket name can be a plain env var in wrangler.jsonc or a secret
R2_BUCKET_NAME=stock-analyze-data

# Local dev fallback paths (optional)
# LOCAL_DUCKDB_PATH=../../data/stock.duckdb
