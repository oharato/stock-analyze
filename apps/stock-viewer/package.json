{
    "name": "stock-viewer",
    "version": "1.0.0",
    "description": "Simple DuckDB Viewer",
    "main": "src/index.ts",
    "scripts": {
        "build:server": "tsgo",
        "build:client": "vite build client",
        "build": "pnpm build:server && pnpm build:client",
        "start": "node dist/index.js",
        "dev:server": "tsgo --watch",
        "dev:client": "vite client --port 5173",
        "dev": "pnpm build:client && pnpm dev:server & pnpm dev:client & node --watch dist/index.js",
        "lint": "oxlint",
        "format": "oxfmt"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@duckdb/node-api": "*",
        "@hono/node-server": "^1.13.7",
        "alpinejs": "^3.15.2",
        "autoprefixer": "^10.4.23",
        "hono": "^4.6.14",
        "lightweight-charts": "^5.1.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18"
    },
    "devDependencies": {
        "@types/alpinejs": "^3.13.11",
        "@types/node": "^20.11.17",
        "@typescript/native-preview": "latest",
        "oxfmt": "latest",
        "oxlint": "latest",
        "typescript": "^5.7.2",
        "vite": "^6.0.0"
    }
}