{
    "name": "stock-viewer",
    "version": "1.1.0",
    "type": "module",
    "description": "Simple DuckDB Viewer",
    "main": "src/worker.ts",
    "scripts": {
        "build:server": "tsgo",
        "build:client": "vite build client",
        "build": "pnpm build:server && pnpm build:client",
        "start": "node dist/index.js",
        "dev:server": "tsgo --watch",
        "dev:client": "vite client --port 5173",
        "dev": "tsgo --watch & vite build client --watch & node --watch dist/index.js",
        "deploy": "wrangler deploy",
        "cf-typegen": "wrangler types",
        "lint": "oxlint",
        "format": "oxfmt",
        "test": "vitest run"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@cloudflare/containers": "0.0.31",
        "@duckdb/node-api": "1.4.3-r.1",
        "@hono/node-server": "^1.19.7",
        "@xenova/transformers": "^2.17.2",
        "alpinejs": "^3.15.3",
        "autoprefixer": "^10.4.23",
        "hono": "^4.11.3",
        "lightweight-charts": "^5.1.0",
        "postcss": "^8.5.6",
        "sharp": "0.33.5",
        "tailwindcss": "^4.1.18"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20251229.0",
        "@types/alpinejs": "^3.13.11",
        "@types/node": "^25.0.3",
        "@typescript/native-preview": "latest",
        "@vitest/ui": "^4.0.16",
        "oxfmt": "latest",
        "oxlint": "latest",
        "typescript": "^5.9.3",
        "vite": "^7.3.0",
        "vitest": "^4.0.16",
        "wrangler": "^4.54.0"
    }
}