{
	"name": "stock-analyze",
	"private": true,
	"scripts": {
		"build": "pnpm -r build",
		"deploy:mcp": "pnpm --filter stock-analyze-mcp run deploy",
		"deploy:ai": "pnpm --filter stock-analyze-ai run deploy",
		"deploy:web": "pnpm --filter stock-analyze-web run deploy",
		"test": "pnpm -r test",
		"dev": "pnpm -r dev",
		"dev:mcp": "pnpm --filter stock-analyze-mcp dev",
		"dev:ai": "pnpm --filter stock-analyze-ai dev",
		"dev:web": "pnpm --filter stock-analyze-web dev",
		"cf-typegen": "pnpm -r cf-typegen"
	},
	"packageManager": "pnpm@10.23.0"
}