{
	"name": "stock-analyze",
	"private": true,
	"scripts": {
		"build": "pnpm -r build",
		"cf-typegen": "pnpm -r cf-typegen",
		"deploy": "pnpm deploy:mcp && pnpm deploy:ai && pnpm deploy:web",
		"deploy:mcp": "pnpm --filter stock-analyze-mcp run deploy",
		"deploy:ai": "pnpm --filter stock-analyze-ai run deploy",
		"deploy:web": "pnpm --filter stock-analyze-web run deploy",
		"dev": "pnpm -r --parallel dev",
		"dev:mcp": "pnpm --filter stock-analyze-mcp dev",
		"dev:ai": "pnpm --filter stock-analyze-ai dev",
		"dev:web": "pnpm --filter stock-analyze-web dev",
		"dev:minio": "docker compose up -d",
		"run:fetch-stock-list": "pnpm --filter stock-analyze-collector run:fetch-stock-list",
		"run:fetch-stock-prices": "pnpm --filter stock-analyze-collector run:fetch-stock-prices",
		"run:fetch-past-fundamentals": "pnpm --filter stock-analyze-collector run:fetch-past-fundamentals",
		"run:fetch-latest-fundamentals": "pnpm --filter stock-analyze-collector run:fetch-latest-fundamentals",
		"run:seed-edinet": "pnpm --filter stock-analyze-collector run:seed-edinet",
		"run:consolidate-data": "pnpm --filter stock-analyze-collector run:consolidate-data",
		"test": "pnpm -r test"
	},
	"packageManager": "pnpm@10.23.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"sharp"
		]
	}
}